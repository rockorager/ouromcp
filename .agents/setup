#!/usr/bin/env bash
set -euo pipefail

version=0.16.0
case "$(uname -m)" in
  x86_64) arch=x86_64; sha=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00 ;;
  aarch64) arch=aarch64; sha=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17 ;;
  *) echo "Unsupported architecture" >&2; exit 1 ;;
esac
root="$HOME/.local/share/ouromcp"
toolchain="$root/zig-$arch-linux-$version"
if [[ ! -x "$toolchain/zig" ]]; then
  temp="$(mktemp -d)"
  trap 'rm -rf "$temp"' EXIT
  curl --fail --silent --show-error --location \
    "https://ziglang.org/download/$version/zig-$arch-linux-$version.tar.xz" -o "$temp/zig.tar.xz"
  printf '%s  %s\n' "$sha" "$temp/zig.tar.xz" | sha256sum --check
  mkdir -p "$root"
  tar -xJf "$temp/zig.tar.xz" -C "$root"
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$toolchain/zig" "$HOME/.local/bin/zig"
"$toolchain/zig" version
python3 --version
